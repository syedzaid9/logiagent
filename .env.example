# ==============================================================================
# LogiAgent — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development # development | staging | production
PROJECT_NAME="LogiAgent - AI Logistics Management System"
VERSION="1.0.0"

# Database Configuration
# Local SQLite default: sqlite:///./logiagent.db
# PostgreSQL / Supabase production:
DATABASE_URL=sqlite:///./logiagent.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Security & JWT Token
JWT_SECRET=replace-with-a-very-long-and-cryptographically-secure-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (Comma-separated list of approved origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Sliding-Window Rate Limiting (In-memory, zero-dependency)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=20
RATE_LIMIT_ROUTE_OPTIMIZE=30
RATE_LIMIT_WINDOW_SECONDS=60

# LLM Providers (Optional - LogiAgent includes high-accuracy deterministic fallback engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto

# External Logistics APIs (Mockable abstractions included)
MAPS_API_KEY=
TRAFFIC_API_KEY=
WEATHER_API_KEY=

# Storage & Vector DB (Supabase pgvector)
OBJECT_STORAGE_BUCKET=logiagent-documents-bucket
VECTOR_DB_URL=
EMBEDDING_MODEL_TYPE=local # local (sentence-transformers) or gemini
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2 # or models/text-embedding-004
EMBEDDING_DIMENSION=384 # 384 for MiniLM, 768 for Gemini text-embedding-004
